// ========================================
// ASTROCOMPANION
// Rappels + DHT22 (AM2302) + Buzzer + LED RGB
// ESP32 connecte a l'API Laravel (workshop_db)
// ========================================

#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include "DHT.h"

// ---------- Configuration reseau ----------
const char* WIFI_SSID     = "id réseau";
const char* WIFI_PASSWORD = "pw réseau";

// IP du PC qui fait tourner Docker, SUR LE WI-FI "POCO F5".
// Sur le PC : ipconfig -> "Adresse IPv4" de la carte Wi-Fi.
// "localhost" ne marche pas : pour l'ESP32, localhost = lui-meme.
const char* API_BASE = "http://@:8000/api";

// ---------- Capteurs dans la table matos_iot ----------
// Temperature : ligne existante "Capteur Temperature Serre" (id 1)
const int   MATOS_ID_TEMP   = 1;
// Humidite de l'air : ligne creee automatiquement dans matos_iot si absente
const char* NOM_CAPTEUR_HUM = "Capteur Humidite Air";
int matosIdHum = -1;

// ---------- Broches ----------
#define LED_R 18
#define LED_G 19
#define LED_B 21
#define BIPE  23
#define CAPTEUR_TEMP 4
#define DHTTYPE DHT22

DHT dht(CAPTEUR_TEMP, DHTTYPE);

// ---------- Durees ----------
const unsigned long DUREE_RAPPEL            = 5000;
const unsigned long INTERVALLE_CLIGNOTEMENT = 500;
const unsigned long INTERVALLE_TEMP         = 2000;   // lecture locale
const unsigned long INTERVALLE_ENVOI        = 30000;  // envoi vers l'API
const unsigned long INTERVALLE_WIFI         = 10000;  // verification du Wi-Fi

// ---------- Etats ----------
enum Etat { AUCUN, EAU, MANGER, DORMIR };

struct Rappel {
  String heure;
  String message;
  Etat   etat;
};

const int MAX_RAPPELS = 20;
Rappel planning[MAX_RAPPELS];
int nombreRappels = 0;

int rappelActuel = 0;
unsigned long debutRappel          = 0;
unsigned long dernierClignotement  = 0;
unsigned long derniereLectureTemp  = 0;
unsigned long dernierEnvoi         = 0;
unsigned long derniereVerifWifi    = 0;

float derniereTemp = NAN;
float derniereHum  = NAN;

bool ledAllumee         = false;
bool simulationTerminee = false;
bool dejaEnvoye         = false;

// ========================================
// Sorties (LED + Buzzer)
// Couleurs alignees sur la base : eau = bleu, nourriture = vert, sommeil = rouge
// ========================================

void eteindreSorties() {
  digitalWrite(LED_R, LOW);
  digitalWrite(LED_G, LOW);
  digitalWrite(LED_B, LOW);
  digitalWrite(BIPE, LOW);
}

void activerSorties(Etat etat) {
  eteindreSorties();

  switch (etat) {
    case EAU:
      digitalWrite(LED_B, HIGH);
      digitalWrite(BIPE, HIGH);
      break;
    case MANGER:
      digitalWrite(LED_G, HIGH);
      digitalWrite(BIPE, HIGH);
      break;
    case DORMIR:
      digitalWrite(LED_R, HIGH);
      digitalWrite(BIPE, HIGH);
      break;
    default:
      break;
  }
}

// ========================================
// Wi-Fi
// ========================================

void connecterWifi() {
  Serial.print("Connexion au Wi-Fi");
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  unsigned long debut = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - debut < 20000) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("Connecte. IP de l'ESP32 : ");
    Serial.println(WiFi.localIP());
    Serial.print("API visee : ");
    Serial.println(API_BASE);
  } else {
    Serial.println("Echec Wi-Fi : fonctionnement hors ligne.");
  }
}

// Relance le Wi-Fi s'il a ete perdu (hotspot coupe, hors de portee...)
void verifierWifi() {
  if (WiFi.status() == WL_CONNECTED) return;
  Serial.println("Wi-Fi perdu, reconnexion...");
  WiFi.reconnect();
}

// ========================================
// Appels API
// ========================================

// Envoie une requete a l'API.
// Retourne le code HTTP (negatif si le PC est injoignable)
// et place le corps de la reponse dans "reponse" si fourni.
int apiRequete(const char* methode, const String& chemin,
               const String& json = "", String* reponse = nullptr) {
  if (WiFi.status() != WL_CONNECTED) return -1;

  HTTPClient http;
  String url = String(API_BASE) + chemin;
  http.begin(url);
  http.setConnectTimeout(3000);
  http.setTimeout(3000);
  http.addHeader("Accept", "application/json");
  if (json.length() > 0) http.addHeader("Content-Type", "application/json");

  int code = http.sendRequest(methode, json);
  String corps = (code > 0) ? http.getString() : "";
  http.end();

  if (code < 200 || code >= 300) {
    Serial.printf("[API] %s %s -> code %d %s\n", methode, url.c_str(), code, corps.c_str());
    if (code < 0) {
      Serial.println("      PC injoignable : verifier API_BASE, meme Wi-Fi, pare-feu port 8000.");
    }
  }

  if (reponse) *reponse = corps;
  return code;
}

// Remplace les espaces pour pouvoir mettre un texte dans une URL
String encoderUrl(const String& texte) {
  String resultat = texte;
  resultat.replace(" ", "%20");
  return resultat;
}

// Cherche un capteur par son nom dans matos_iot, le cree s'il n'existe pas.
// Retourne son id, ou -1 si l'API est injoignable.
int trouverOuCreerCapteur(const char* nom) {
  String corps;
  int code = apiRequete("GET", String("/matos_iot?nom=") + encoderUrl(nom), "", &corps);
  if (code != 200) return -1;

  JsonDocument doc;
  if (!deserializeJson(doc, corps) && doc.is<JsonArray>() && doc.size() > 0) {
    return doc[0]["id"].as<int>();
  }

  JsonDocument nouveau;
  nouveau["nom"]             = nom;
  nouveau["type"]            = "capteur";
  nouveau["valeur_actuelle"] = "--";
  String json;
  serializeJson(nouveau, json);

  code = apiRequete("POST", "/matos_iot", json, &corps);
  if (code != 201) return -1;

  doc.clear();
  if (deserializeJson(doc, corps)) return -1;

  Serial.printf("[API] Capteur \"%s\" cree dans matos_iot\n", nom);
  return doc["id"].as<int>();
}

// ========================================
// Planning : charge depuis l'API, sinon valeurs par defaut
// ========================================

Etat etatDepuisTexte(const String& texte) {
  String t = texte;
  t.toUpperCase();

  if (t.indexOf("EAU") >= 0 || t.indexOf("BOIRE") >= 0 || t.indexOf("HYDRAT") >= 0) return EAU;
  if (t.indexOf("MANGER") >= 0 || t.indexOf("REPAS") >= 0 || t.indexOf("NOURRITURE") >= 0) return MANGER;
  if (t.indexOf("DORMIR") >= 0 || t.indexOf("SOMMEIL") >= 0 || t.indexOf("REVEIL") >= 0) return DORMIR;
  return AUCUN;
}

// Cherche la premiere cle existante parmi plusieurs noms possibles
String champ(JsonObjectConst ligne, const char* cles[], int n) {
  for (int i = 0; i < n; i++) {
    if (!ligne[cles[i]].isNull()) return ligne[cles[i]].as<String>();
  }
  return "";
}

// "07:30:00" -> "07h30"
String formaterHeure(const String& heure) {
  if (heure.length() >= 5 && heure.charAt(2) == ':') {
    return heure.substring(0, 2) + "h" + heure.substring(3, 5);
  }
  return heure;
}

void chargerPlanningParDefaut() {
  const char* heures[]   = {"07h00", "07h30", "10h30", "12h30", "16h00", "18h00", "20h30", "22h30", "23h00"};
  const char* messages[] = {"Reveil", "Manger", "Boire de l'eau", "Manger", "Manger",
                            "Boire de l'eau", "Manger", "Boire de l'eau", "Dormir"};
  const Etat  etats[]    = {DORMIR, MANGER, EAU, MANGER, MANGER, EAU, MANGER, EAU, DORMIR};

  nombreRappels = 9;
  for (int i = 0; i < nombreRappels; i++) {
    planning[i].heure   = heures[i];
    planning[i].message = messages[i];
    planning[i].etat    = etats[i];
  }
  Serial.println("Planning par defaut charge.");
}

void chargerPlanning() {
  String corps;
  int code = apiRequete("GET", "/routines_quotidiennes?actif=1", "", &corps);

  if (code != 200) {
    Serial.println("Planning indisponible via l'API.");
    chargerPlanningParDefaut();
    return;
  }

  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, corps);

  if (err || !doc.is<JsonArray>() || doc.size() == 0) {
    Serial.println("Reponse API illisible ou vide.");
    chargerPlanningParDefaut();
    return;
  }

  // "heure_precise" et "description" = colonnes de routines_quotidiennes
  const char* clesHeure[]   = {"heure_precise", "heure", "heure_declenchement", "horaire"};
  const char* clesMessage[] = {"description", "message", "libelle", "nom"};

  nombreRappels = 0;
  for (JsonObjectConst ligne : doc.as<JsonArrayConst>()) {
    if (nombreRappels >= MAX_RAPPELS) break;

    String heure   = champ(ligne, clesHeure, 4);
    String message = champ(ligne, clesMessage, 4);

    // Routine sans heure (ex : verification capteur) : pas un rappel
    if (heure.length() == 0 || message.length() == 0) continue;

    planning[nombreRappels].heure   = formaterHeure(heure);
    planning[nombreRappels].message = message;
    planning[nombreRappels].etat    = etatDepuisTexte(message);
    nombreRappels++;
  }

  if (nombreRappels == 0) {
    chargerPlanningParDefaut();
  } else {
    Serial.print("Planning charge depuis l'API : ");
    Serial.print(nombreRappels);
    Serial.println(" rappel(s).");
  }
}

// ========================================
// Rappels
// ========================================

void lancerRappel() {
  Serial.println("======================");
  Serial.print("Heure simulee : ");
  Serial.println(planning[rappelActuel].heure);
  Serial.print("Notification : ");
  Serial.println(planning[rappelActuel].message);
  Serial.println("======================");

  debutRappel         = millis();
  dernierClignotement = millis();
  ledAllumee          = false;
}

// ========================================
// Capteur
// ========================================

void lireTemperature() {
  float temp = dht.readTemperature();
  float hum  = dht.readHumidity();

  if (isnan(temp) || isnan(hum)) {
    Serial.println("--> [DHT22] Erreur de lecture ! Verifier le cablage.");
    return;
  }

  derniereTemp = temp;
  derniereHum  = hum;

  Serial.print("--> [DHT22] Temp : ");
  Serial.print(temp, 1);
  Serial.print(" C | Humidite : ");
  Serial.print(hum, 1);
  Serial.println(" %");
}

// Enregistre une mesure dans logs_capteurs
// puis met a jour la valeur actuelle du capteur dans matos_iot.
// Retourne le code HTTP du POST (negatif si le PC est injoignable).
int envoyerMesure(int matosId, const String& valeur) {
  if (matosId < 0) return 0;

  JsonDocument doc;
  doc["matos_id"]       = matosId;
  doc["valeur_mesuree"] = valeur;
  String json;
  serializeJson(doc, json);

  int code = apiRequete("POST", "/logs_capteurs", json);
  if (code != 201) return code;

  Serial.printf("[API] Mesure envoyee (matos %d) : %s\n", matosId, valeur.c_str());

  doc.clear();
  doc["valeur_actuelle"] = valeur;
  json = "";
  serializeJson(doc, json);
  apiRequete("PUT", String("/matos_iot/") + matosId, json);

  return code;
}

void envoyerMesures() {
  if (isnan(derniereTemp) || isnan(derniereHum)) return;

  // Meme format que les donnees de depart : "22.5C" et "45.0%"
  if (envoyerMesure(MATOS_ID_TEMP, String(derniereTemp, 1) + "C") < 0) return;

  // Si l'API etait injoignable au demarrage, on retrouve le capteur maintenant
  if (matosIdHum < 0) matosIdHum = trouverOuCreerCapteur(NOM_CAPTEUR_HUM);
  envoyerMesure(matosIdHum, String(derniereHum, 1) + "%");
}

// ========================================
// Initialisation
// ========================================

void setup() {
  Serial.begin(115200);
  delay(200);

  pinMode(LED_R, OUTPUT);
  pinMode(LED_G, OUTPUT);
  pinMode(LED_B, OUTPUT);
  pinMode(BIPE, OUTPUT);
  eteindreSorties();

  dht.begin();
  connecterWifi();
  chargerPlanning();
  matosIdHum = trouverOuCreerCapteur(NOM_CAPTEUR_HUM);

  Serial.println("AstroCompanion Ready !");
  lancerRappel();
}

// ========================================
// Boucle principale
// ========================================

void loop() {
  unsigned long maintenant = millis();

  // 1. Surveillance du Wi-Fi
  if (maintenant - derniereVerifWifi >= INTERVALLE_WIFI) {
    derniereVerifWifi = maintenant;
    verifierWifi();
  }

  // 2. Lecture du capteur
  if (maintenant - derniereLectureTemp >= INTERVALLE_TEMP) {
    derniereLectureTemp = maintenant;
    lireTemperature();
  }

  // 3. Envoi vers la base (des la premiere lecture valide, puis toutes les 30 s)
  if (!isnan(derniereTemp) && (!dejaEnvoye || maintenant - dernierEnvoi >= INTERVALLE_ENVOI)) {
    dejaEnvoye   = true;
    dernierEnvoi = maintenant;
    envoyerMesures();
  }

  // 4. Fin de simulation (les mesures continuent d'etre envoyees)
  if (simulationTerminee) {
    eteindreSorties();
    return;
  }

  // 5. Clignotement LED + Buzzer
  if (maintenant - dernierClignotement >= INTERVALLE_CLIGNOTEMENT) {
    dernierClignotement = maintenant;
    ledAllumee = !ledAllumee;

    if (ledAllumee) {
      activerSorties(planning[rappelActuel].etat);
    } else {
      eteindreSorties();
    }
  }

  // 6. Rappel suivant
  if (millis() - debutRappel >= DUREE_RAPPEL) {
    eteindreSorties();
    rappelActuel++;

    if (rappelActuel >= nombreRappels) {
      Serial.println("Simulation terminee !");
      simulationTerminee = true;
      return;
    }

    lancerRappel();
  }
}
